# cocoa tasks. `alors` with no arguments lists them.
#
# Run it from the repository root — alors reads the tasks.alors in the current
# directory and never looks upward, so this file is the whole surface.
#
# Bare tasks act on `cocoa-electron/`, because that is cocoa (doc/spec/product.md). The
# MCP server lives under its own namespace: `alors mcp ...`.
#
# The exit code is the verdict for every task here — read that, not the output.
# A summary line like "13 passed; 1 failed" still contains the word "passed",
# and a run that greps for it will call a red suite green.

electron := cocoa-electron
mcp := cocoa-mcp


# --- the workbench -----------------------------------------------------------

# Run it. `env -u` because VSCode terminals leak ELECTRON_RUN_AS_NODE, which
# makes Electron start as a bare node and never open a window.
dev:
    cd {{electron}}
    env -u ELECTRON_RUN_AS_NODE npm run dev

# The gate before committing: format, lint, types, tests, cheapest failure
# first. npm owns the sequence so there is one definition of it, not two.
gate:
    cd {{electron}}
    npm run gate

# Both trees, for a change that crosses them.
gate::all: gate, mcp::gate
    echo "both trees are clean"

test:
    cd {{electron}}
    npm test

# Types only: svelte-check on the renderer, tsc on main and preload.
check:
    cd {{electron}}
    npm run check

lint:
    cd {{electron}}
    npm run lint

fmt:
    cd {{electron}}
    npm run format

build:
    cd {{electron}}
    npm run build

# An installable build in cocoa-electron/release/. Unsigned.
package:
    cd {{electron}}
    npm run package

# Put the packaged app where this desktop can find it, for this user only —
# no root, nothing outside $HOME.
#
# The point is the icon. GNOME does not ask a window what icon it has if it
# can match the window's WM_CLASS to an installed .desktop; it then resolves
# `Icon=cocoa` through the icon theme and takes whichever size fits the
# surface it is drawing. Without that match it falls back to _NET_WM_ICON,
# which carries one size whatever it is handed, and every dock scales it
# itself. That fallback is the blurry one.
#
# So: the AppImage onto PATH, every size into the theme, and the .desktop
# whose StartupWMClass matches what the window reports (see the executableName
# and productName notes in electron-builder.yml).
#
# To undo it:
#     rm ~/.local/bin/cocoa ~/.local/share/applications/cocoa.desktop
#     rm ~/.local/share/icons/hicolor/*/apps/cocoa.png
install: package
    appimage=$(ls -1 {{electron}}/release/*.AppImage | head -1)
    test -n "$appimage" || { echo "no AppImage in {{electron}}/release/"; exit 1; }
    mkdir -p "$HOME/.local/bin"
    cp "$appimage" "$HOME/.local/bin/cocoa"
    chmod +x "$HOME/.local/bin/cocoa"
    for png in {{electron}}/build/icons/*x*.png; do
        dir="$HOME/.local/share/icons/hicolor/$(basename "$png" .png)/apps"
        mkdir -p "$dir"
        cp "$png" "$dir/cocoa.png"
    done
    mkdir -p "$HOME/.local/share/applications"
    printf '[Desktop Entry]\nType=Application\nName=cocoa\nComment=A desktop workbench for experiments that live on your own machine\nExec=%s/.local/bin/cocoa %%U\nIcon=cocoa\nTerminal=false\nCategories=Development;\nStartupWMClass=cocoa\n' "$HOME" > "$HOME/.local/share/applications/cocoa.desktop"
    update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
    gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
    echo "installed $HOME/.local/bin/cocoa — run it as 'cocoa', or find it in Activities"

# Drive the built app under Playwright and watch it work — the path a test
# cannot take. Scenario is a name from cocoa-electron/scripts/scenarios/:
#
#     alors drive cancel
#     alors drive bench-child
#
# Screenshots land in cocoa-electron/.drive/shots/.
drive scenario:
    cd {{electron}}
    npm run build
    env -u ELECTRON_RUN_AS_NODE npm run drive scripts/scenarios/{{scenario}}.mjs


# --- the MCP server ----------------------------------------------------------

# Build and test it. The binary an agent's MCP client launches; it speaks only
# the §43.2 socket, so it drives the workbench unchanged (doc/spec/agent.md).
mcp: mcp::gate

mcp::build:
    cd {{mcp}}
    cargo build

mcp::test:
    cd {{mcp}}
    cargo test

mcp::gate:
    cd {{mcp}}
    cargo fmt --all -- --check
    cargo clippy --all-targets -- -D warnings
    cargo test

mcp::fmt:
    cd {{mcp}}
    cargo fmt --all
