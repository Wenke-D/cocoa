# Rust / Cargo build output
/coco-mcp/target
**/*.rs.bk
*.pdb

# Note: Cargo.lock is intentionally tracked — this crate builds a binary.

# Environment / secrets
.env
.env.*
!.env.example
/deepseek.env
*.pem
*.key

# Local Codex/Claude configuration switchers (kept out of the repo)
/switch-codex.sh
/switch-claude.sh

# Bundled example experiments: generated state stays out of the repo
/examples/**/runs/
/examples/**/report/

# Python bytecode from the example scripts
__pycache__/
*.py[cod]

# Editors and IDEs
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS cruft
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
.directory
