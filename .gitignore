# Rust / Cargo build output
/target
**/*.rs.bk
*.pdb

# Note: Cargo.lock is intentionally tracked — this crate builds a binary.

# Screenshot example output (see examples/screenshot.rs)
/out
/screenshot.png

# Environment / secrets
.env
.env.*
!.env.example
/deepseek.env
*.pem
*.key

# Local Codex/Claude configuration switchers (kept out of the repo)
/switch-codex.sh
/switch-claude.sh

# Bundled mock experiments: generated state stays out of the repo
/mock/**/runs/
/mock/**/report/

# Python bytecode from the mock scripts
__pycache__/
*.py[cod]

# Editors and IDEs
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS cruft
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
.directory
